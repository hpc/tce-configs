#!/usr/bin/python3

import sys
import argparse
from pathlib import Path
import re

def main():
    
    parser = argparse.ArgumentParser("Print duplicate packages found during concretization.")

    group = parser.add_mutually_exclusive_group()
    group.add_argument('--hash', action='store_true', 
        help="Show packages that are the same except for their hash")
    group.add_argument('--version', action='store_true', 
        help="Show packages with multiple versions.")
    parser.add_argument('conc_logs', action='store', type=Path, nargs='+',
        help="An install or concretization log to check. If a directory or multiple files are "
             "given, then newest of the file found is used.")

    args = parser.parse_args()

    log_file = find_log(args.conc_logs)
    if not log_file:
        print("No suitable file found.", file=sys.stderr)
        sys.exit(1)
    else:
        print("Using file '{}'.".format(log_file.name), file=sys.stderr)


    try:
        with log_file.open() as file:
            specs = get_specs(file)            
    except OSError as err:
        print("Error reading file '{}': {}".format(log_file, err), file=sys.stderr)
        sys.exit(1)

    if not specs:
        print("No specs found", file=sys.stderr)
        sys.exit(1)

    if args.hash:
        return find_hash_dups(specs)
    elif args.version:
        return find_version_dups(specs)
    else:
        for shash, pkg, vers, compiler in specs:
            print(shash, pkg, vers, compiler)


def find_log(paths):
    """Find a log file for the given path.

    - If multiple files are given, choose the newest (the *.log case)
    - If a directory is given, find the log directory, and return the newest 
      inst.log or conc.log file.
    - If a specific file is given, just use that.
    """

    dirs = []
    files = []

    for path in paths:
        if not path.exists():
            print("No such path: {}".format(path), file=sys.stderr)
        elif path.is_dir():
            dirs.append(path)
        else:
            files.append(path)

    while dirs:
        dir_path = dirs.pop(0)
        dir_files = []

        for path in dir_path.iterdir():
            if path.name == 'logs':
                # If we're not pointed at the logs directory, go there.
                dirs.append(dir_path/path)
                break
            # Don't recurse
            elif not path.is_dir():
                dir_files.append(path)
        else:
            files.extend(dir_files)


    final_files = []
    for path in files:
        base = path.stem.split('.')[0]
        # Only grab install and concretization log files.
        if path.suffix == '.log' and base in ('inst', 'conc'):
            final_files.append(path)

    final_files.sort(key=lambda f: f.stat().st_mtime)
    if not final_files:
        return []

    # The last file is the most recent.
    return final_files.pop() 


def get_specs(file):

    pkg_re = re.compile(r'^[^%@]+')
    comp_re = re.compile(r'%[^@]+')
    vers_re = re.compile(r'@[^%]+')
    
    specs = set()
    for line in file:
        line = line.strip()

        if not (line.startswith('-') or line.startswith('[+]') or line.startswith('[^]')):
            continue

        try:
            _, shash, spec = line.split(maxsplit=2)
        except ValueError:
            print('bad line', line)
            continue

        for sym in ' +~':
            sym_loc = spec.find(sym)
            if sym_loc > 0:
                spec = spec[:sym_loc]

        if spec.startswith('^'):
            spec = spec[1:]
        
        pkg = pkg_re.search(spec)
        if pkg:
            pkg = pkg.group()
        comp = comp_re.search(spec)
        if comp:
            comp = comp.group()
        vers = vers_re.search(spec)
        if vers:
            vers = vers.group()
        else:
            print(line)
            print(spec)
        
        specs.add((shash, pkg, vers, comp))
    
    specs = list(specs)

    return specs

def find_version_dups(specs):

    specs = [((pkg, comp), vers, shash) for shash, pkg, vers, comp in specs]
    specs.sort()

    last_vers = None
    last_spec = None
    last_shash = None
    printed = []
    
    for spec, vers, shash in specs:
        if last_spec and spec == last_spec and last_vers != vers:
            if last_shash not in printed:
                print(last_spec, last_vers, last_shash)
                printed.append(last_shash)
            if shash not in printed:
                print(spec, vers, shash)
                printed.append(shash)
        last_shash = shash
        last_vers = vers
        last_spec = spec

    return len(printed)


def find_hash_dups(specs):

    specs = [((pkg, vers, comp), shash) for shash, pkg, vers, comp in specs]
    specs.sort()
    
    last_shash = None
    last_spec = None
    printed = []

    for spec, shash in specs:
        if last_spec and spec == last_spec:
            if last_shash not in printed:
                print(last_shash, last_spec)
                printed.append(last_shash)
            if shash not in printed:
                print(shash, spec)
                printed.append(shash)
        last_shash = shash
        last_spec = spec

    return len(printed)

if __name__ == '__main__':
    main()
