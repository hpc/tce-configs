#!/usr/bin/python3

import sys
from collections import defaultdict
import argparse
import shutil
import subprocess
from pathlib import Path
import re
import yaml


class Spec:
    def __init__(self, shash, pkg, version, compiler, raw):
        
        self.shash = shash
        self.pkg = pkg
        self.version = version
        self.compiler = compiler
        self.raw = raw

    # These are needed for uniqueness to be maintained
    def __eq__(self, other):
        return self.shash == other.shash

    def __lt__(self, other):
        if self.pkg == other.pkg:
            return self.version < other.version
        else:
            return self.pkg < other.pkg

    def __hash__(self):
        return hash(self.shash)


def error(*args, **kwargs):
    """Print an error message and exit."""

    warn(*args, **kwargs)
    sys.exit(1)


def warn(*args, **kwargs):
    """Print a warning to stderr."""

    kwargs['file'] = sys.stderr
    print(*args, **kwargs)


def main():
    
    parser = argparse.ArgumentParser("Check the concretization log against the Spack.yaml for "
        "correctness in a variety of ways.")
    
    parser.add_argument('--hash', action='store_true', 
        help="Show packages that are the same except for their hash")
    parser.add_argument('--version', action='store_true', 
        help="Show packages with multiple versions.")
    parser.add_argument('--base', action='store_true',
        help="Check that all packages in the 'base' definition in the given spack.yaml occur for "
             "only one compiler.")
    parser.add_argument('--packages', action='store_true', 
        help="Check that all packages built exist in the package section of the given spack.yaml, "
             "and that the versions to be built match the versions defined.")
    parser.add_argument('--all', action='store_true', 
        help="Run all checks.")
    parser.add_argument('install_path', action='store', type=Path,
        help="Path to the install area for the environment (the install path + environment name, "
             "typically).")
    parser.add_argument('-c', '--conc_log', action='store', type=Path,
        help="The specific concretization log to look at. Can be a full path or just a log name.")
    parser.add_argument('-e', '--env', action='store', 
        help="The name of the environment to examine. By default, a single environment is "
             "assumed.")

    args = parser.parse_args()

    log_file = find_log(args.install_path, args.conc_log)
    if not log_file:
        error("No suitable file found.")
        sys.exit(1)
    else:
        warn("Using file '{}'.".format(log_file.name))

    try:
        with log_file.open() as file:
            specs = get_specs(file)            
    except OSError as err:
        error("Error reading file '{}': {}".format(log_file))
        sys.exit(1)

    if not specs:
        error("No specs found")
        sys.exit(1)

    spack_yaml = load_spack_yaml(args.install_path, args.env)

    if args.all:
        args.hash = args.base = args.version = args.packages = True

    exit_code = 0
    if args.hash:
        exit_code += find_hash_dups(specs)
    if args.version:
        exit_code += find_version_dups(specs)
    if args.base:
        exit_code += check_base(specs, spack_yaml)
    if args.packages:
        exit_code += check_packages(specs, spack_yaml)
    else:
        for spec in specs:
            print("{:7s} {:25s} @{:15s} %{}"
                  .format(spec.shash, spec.pkg, spec.version, spec.compiler))
        print('{} uniq specs concretized'.format(len(specs)))
                  

def find_log(install_path, log_name):
    """Find a log file for the given path.

    - If multiple files are given, choose the newest (the *.log case)
    - If a directory is given, find the log directory, and return the newest 
      inst.log or conc.log file.
    - If a specific file is given, just use that.
    """

    # If a path to a specific log was specified, just use that.
    if log_name is not None and Path(log_name).exists():
        return Path(log_name)

    log_path = install_path/'logs'

    if log_name:
        log_path = log_path/log_name
        if log_path.exists():
            return log_path
        else:
            error("Specified log name '{}' does not exist at '{}'"
                  .format(log_name, log_path))

    files = []
    for path in log_path.iterdir():
        if path.is_dir():
            # Ignore directories
            continue

        base = path.stem.split('.')[0]
        # Only grab install and concretization log files.
        if path.suffix == '.log' and base in ('inst', 'conc'):
            files.append(path)

    files.sort(key=lambda f: f.stat().st_mtime)
    if not files:
        error("No install or concretization log found in '{}'"
              .format(log_path))

    # The last file is the most recent.
    return files.pop() 


def load_spack_yaml(path, env):

    env_dir = path/'spack/var/spack/environments'
    if not env_dir.is_dir():
        error("Expected an environments directory here: {}".format(env_dir))    

    if env:
        env_dir = env_dir/env
        if not env_dir.is_dir():
            error("Specified environment '{}' does not exist here: {}".format(env, env_dir))
    else:
        environments = [dirpath for dirpath in env_dir.iterdir() 
                        if dirpath.is_dir() and (dirpath/'spack.yaml').exists()]
        if not environments:
            error("No valid spack environments in env dir: {}".format(env_dir))

        if len(environments) > 1:
            error("Multiple environments exist ({}), specify one with '-e <env_name>'"
                  .format([dirpath.name for dirpath in environments]))

        env_dir = environments[0]

    spack_yaml_path = env_dir/'spack.yaml'

    # Check for the spack.yaml file
    if not spack_yaml_path.exists():
        error("No spack.yaml file in the environment '{}'".format(env_dir))

    try:
        with spack_yaml_path.open() as yaml_file:
            return yaml.load(yaml_file, Loader=yaml.SafeLoader)

    except OSError as err:
        error("Error reading yaml file '{}':\n    {}".format(path, err))
    except yaml.YAMLError as err:
        error("Error parsing spack.yaml file at '{}':\n    {}".format(path, err))


def get_specs(file):

    pkg_re = re.compile(r'^[^%@]+')
    vers_re = re.compile(r'@([^%]+)')
    comp_re = re.compile(r'%([^ ]+)')
    
    specs = set()
    for line in file:
        line = line.strip()

        # Concretization output ends here.
        if line.startswith('==> Installing environment'):
            break

        if not (line.startswith('-') or line.startswith('[+]') or line.startswith('[^]')):
            continue

        try:
            _, shash, spec = line.split(maxsplit=2)
        except ValueError:
            warn('bad line')
            continue

        for sym in ' +~':
            sym_loc = spec.find(sym)
            if sym_loc > 0:
                spec = spec[:sym_loc]

        if spec.startswith('^'):
            spec = spec[1:]
        
        pkg = pkg_re.search(spec)
        if pkg:
            pkg = pkg.group()
        comp = comp_re.search(spec)
        if comp:
            comp = comp.groups()[0]
        vers = vers_re.search(spec)
        if vers:
            vers = vers.groups()[0]
        else:
            warn(line)
            warn(spec)
        
        specs.add(Spec(shash, pkg, vers, comp, line))
    
    specs = list(specs)

    return specs

def find_version_dups(specs):

    specs.sort(key=lambda s: (s.pkg, s.compiler))

    last = None
    printed = []
    
    dup_versions = defaultdict(set)

    for spec in specs:
        if last and spec.pkg == last.pkg and last.version != spec.version:
            dup_versions[spec.pkg].add(spec.version)
            dup_versions[spec.pkg].add(last.version)
        last = spec

    if not dup_versions:
        warn("No packages with multiple versions found.")
        return 0

    pkg_width = max([len(pkg) for pkg in dup_versions])

    warn("Packages with multiple versions found.")
    for pkg in sorted(dup_versions.keys()):
        versions = [str(version) for version in dup_versions[pkg]]
        versions = ', '.join(sorted(versions))

        print("  {:{width}s} {}".format(pkg, versions, width=pkg_width))

    return 1


def find_hash_dups(specs):

    specs.sort(key=lambda s: (s.pkg, s.version, s.compiler))
    
    last = None

    extra_hashes = defaultdict(set)

    for spec in specs:
        if (last and spec.pkg == last.pkg and spec.compiler == last.compiler and 
                spec.version ==last.version):
            extra_hashes[spec.pkg].add(spec.shash)
            extra_hashes[spec.pkg].add(last.shash)
        last = spec

    if not extra_hashes:
        warn("No packages with multiple hashes found.")
        return 0

    pkg_width = max([len(pkg) for pkg in extra_hashes])

    warn("Packages with multiple hashes found:")
    for pkg in sorted(extra_hashes):
        hashes = ', '.join(sorted(extra_hashes[pkg]))
        print("  {:{width}s} {}".format(pkg, hashes, width=pkg_width))

    return 1


PACKAGE_RE = re.compile(r'(?P<pkg>[a-zA-Z0-9_-]+)\s*'  # Package 
                        r'(?:@(?P<version>[a-zA-Z0-9_.-]+))?\s*' # Package version
                        # Compiler and compiler version
                        r'(?:%(?P<compiler>[a-zA-Z0-9_-]+(?:@[a-zA-Z0-9_.-]+)?))?') 


def check_base(specs, spack_yaml):
    """Check the packages defined in the 'base' definition against the concretized specs. 
    They should all be present, and only concretized against the base compiler."""

    definitions = spack_yaml.get('spack', {}).get('definitions', [])
    if not definitions:
        error("Could not find definititons section in the spack.yaml")

    if not isinstance(definitions, list):
        error("Expected the definitions section to be a list. Got: {}".format(definitions))

    base = None
    base_compiler = None
    for defn in definitions:
        if not isinstance(defn, dict):
            continue

        if 'base' in defn:
            base = defn['base']

        if 'base-compiler' in defn:
            base_compiler = defn['base-compiler']
            if not isinstance(base_compiler, list) or  len(base_compiler) != 1:
                error("Expected base_compiler definition to be a list of one item, got '{}'"
                      .format(base_compiler))

            base_compiler = base_compiler[0]

    if not base:
        error("Could not find 'base' definitions in the spack.yaml.")

    if not base_compiler:
        error("Could not find 'base-compiler' definition in the spack.yaml.")

    missing = []
    mismatched = []
    for package in base:
        pkg_def = PACKAGE_RE.match(package)
        if not pkg_def:
            warn("Could not parse package def: '{}'".format(package))

        pkg_def = pkg_def.groupdict()

        matches = find_spec(specs, pkg=pkg_def['pkg'])
        if not matches:
            missing.append(package)

        for spec in matches:
            if spec.compiler != base_compiler:
                mismatched.append((package, spec))
        
    if missing:
        warn("These packages were in base, but we couldn't find a concretized spec:")

        for package in missing:
            print("  -", package)

    if mismatched:
        warn("These packages were built with the wrong compiler.")
        warn("Expected {}".format(base_compiler))
        for package, spec in mismatched:
            print(" ", spec.pkg, spec.version, spec.compiler)

    if not missing or mismatched:
        warn("No mismatched or missing base packages.")
        return 0
    else:
        return 1


def check_packages(specs, spack_yaml):
    """Make sure all of the concretized specs match the versions specified in the packages 
    section."""

    packages = spack_yaml.get('spack', {}).get('packages', {})

    if not packages:
        error("Packages section in spack.yaml was empty.")

    # Look for cases where versions that look like ints/floats weren't quoted
    bad_vers_format = []
    for pkg in packages:
        for vers in packages.get(pkg, {}).get('version', []):
            if not isinstance(vers, str):
                bad_vers_format.append((pkg, vers))

    missing_package_defs = set()
    no_version = set()
    wrong_version = set()
    for spec in specs:
        if spec.pkg not in packages:
            missing_package_defs.add(spec)
            continue
        pkg_defaults = packages[spec.pkg]
        def_version = pkg_defaults.get('version', [])

        if not def_version:
            no_version.add(spec)
            continue

        if spec.version not in def_version:
            wrong_version.add(spec)
            continue


    if not (missing_package_defs or no_version or wrong_version or bad_vers_format):
        warn("All concretized versions match the defined default versions.")
        return 0

    if bad_vers_format:
        warn("These packages had versions that need to be quoted.")
        bad_vers_format = sorted(bad_vers_format)
        for pkg, vers in bad_vers_format:
            print("  {}  {}".format(pkg, vers))

    if missing_package_defs:
        warn("The following packages were concretized, but had no defined defaults:")
        if shutil.which('spack') is None:
            print("Activate the spack environment to see the spack preferred versions.")

        missing_package_defs = sorted(missing_package_defs)
        for spec in missing_package_defs:
            preferred = get_spack_preferred_version(spec) or ''
            print("    {}:".format(spec.pkg))
            if preferred and preferred != spec.version:
                print("      # Spack preferred: {}".format(preferred))
            print("      version: ['{}']".format(spec.version))
           
    if no_version:
        warn("These packages had package defaults, but no set version:")
        no_version = sorted(no_version)
        for spec in no_version:
            preferred = get_spack_preferred_version(spec) or ''
            print(" ", spec.pkg, preferred)

    if wrong_version:
        wrong_version = sorted(wrong_version)
        warn("These packages were concretized at a version outside of the set defaults:")
        pkg_width = max([len(spec.pkg) for spec in wrong_version])
        ver_width = max([len(str(spec.version)) for spec in wrong_version])
        format_str = "  {{:{}s}} {{:{}s}} {{}}".format(pkg_width, ver_width)
        warn(format_str.format("Package", "Conc Vers", "spack.yaml Version"))
        for spec in wrong_version:
            pkg_defaults = packages.get(spec.pkg, {})
            def_version = pkg_defaults.get('version', [])
            print(format_str.format(spec.pkg, spec.version, def_version))

    return 1


def get_width(vals):
    """Get the minimum width needed to display all items evenly"""

    return max([str(val) for val in values])


def find_spec(specs, pkg=None, version=None, compiler=None, shash=None):
    """Find only specs that match all of the given criteria."""

    found = []
    for spec in specs:
        if pkg and spec.pkg != pkg:
            continue
        elif version and spec.version != version:
            continue
        elif compiler and spec.compiler != compiler:
            continue
        elif shash and spec.shash != shash:
            continue

        found.append(spec)

    return found

def get_spack_preferred_version(spec):

    spack = shutil.which('spack')
    if spack is not None:
        cmd = [spack, 'info', '--no-variants', '--no-dependencies', spec.pkg]
        
        out = subprocess.check_output(cmd, stderr=subprocess.DEVNULL)
        lines = out.decode().split('\n')
        for i in range(len(lines)):
            line = lines[i].split()
            if 'Preferred' in line:
                if i+1 < len(lines):
                    return lines[i+1].strip().split()[0]

if __name__ == '__main__':
    main()
