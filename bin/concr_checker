#!/usr/bin/python3

import sys
import argparse
from pathlib import Path
import re
import yaml


class Spec:
    def __init__(self, shash, pkg, version, compiler, raw):
        
        self.shash = shash
        self.pkg = pkg
        self.version = version
        self.compiler = compiler
        self.raw = raw

    # These are needed for uniqueness to be maintained
    def __eq__(self, other):
        return self.shash == other.shash

    def __hash__(self):
        return hash(self.shash)


def error(*args, **kwargs):
    """Print an error message and exit."""

    warn(*args, **kwargs)
    sys.exit(1)


def warn(*args, **kwargs):
    """Print a warning to stderr."""

    kwargs['file'] = sys.stderr
    print(*args, **kwargs)


def main():
    
    parser = argparse.ArgumentParser("Print duplicate packages found during concretization.")

    group = parser.add_mutually_exclusive_group()
    group.add_argument('--hash', action='store_true', 
        help="Show packages that are the same except for their hash")
    group.add_argument('--version', action='store_true', 
        help="Show packages with multiple versions.")
    group.add_argument('--base', action='store', type=Path,
        help="Check that all packages in the 'base' definition in the given spack.yaml occur for "
             "only one compiler.")
    group.add_argument('--packages', action='store', type=Path, 
        help="Check that all packages built exist in the package section of the given spack.yaml, "
             "and that the versions to be built match the versions defined.")
    parser.add_argument('conc_logs', action='store', type=Path, nargs='+',
        help="An install or concretization log to check. If a directory or multiple files are "
             "given, then newest of the file found is used.")

    args = parser.parse_args()

    log_file = find_log(args.conc_logs)
    if not log_file:
        error("No suitable file found.")
        sys.exit(1)
    else:
        warn("Using file '{}'.".format(log_file.name))


    try:
        with log_file.open() as file:
            specs = get_specs(file)            
    except OSError as err:
        error("Error reading file '{}': {}".format(log_file))
        sys.exit(1)

    if not specs:
        error("No specs found")
        sys.exit(1)

    spack_yaml = None
    if args.base or args.packages:
        yaml_path = args.base or args.packages
        spack_yaml = load_spack_yaml(yaml_path)

    if args.hash:
        return find_hash_dups(specs)
    elif args.version:
        return find_version_dups(specs)
    elif args.base:
        return check_base(specs, spack_yaml)
    elif args.packages:
        return check_packages(specs, spack_yaml)
    else:
        for spec in specs:
            print("{:7s} {:25s} @{:15s} %{}"
                  .format(spec.shash, spec.pkg, spec.version, spec.compiler))
        print('{} uniq specs concretized'.format(len(specs)))
                  

def find_log(paths):
    """Find a log file for the given path.

    - If multiple files are given, choose the newest (the *.log case)
    - If a directory is given, find the log directory, and return the newest 
      inst.log or conc.log file.
    - If a specific file is given, just use that.
    """

    dirs = []
    files = []

    for path in paths:
        if not path.exists():
            warn("No such path: {}".format(path))
        elif path.is_dir():
            dirs.append(path)
        else:
            files.append(path)

    while dirs:
        dir_path = dirs.pop(0)
        dir_files = []


#???LINES MISSING
        printed.append(spec.shash)
        last = spec

    return len(printed)


PACKAGE_RE = re.compile(r'(?P<pkg>[a-zA-Z0-9_-]+)\s*'  # Package 
                        r'(?:@(?P<version>[a-zA-Z0-9_.-]+))?\s*' # Package version
                        # Compiler and compiler version
                        r'(?:%(?P<compiler>[a-zA-Z0-9_-]+(?:@[a-zA-Z0-9_.-]+)?))?') 


def check_base(specs, spack_yaml):
    """Check the packages defined in the 'base' definition against the concretized specs. 
    They should all be present, and only concretized against the base compiler."""

    definitions = spack_yaml.get('spack', {}).get('definitions', [])
    if not definitions:
        error("Could not find definititons section in the spack.yaml")

    if not isinstance(definitions, list):
        error("Expected the definitions section to be a list. Got: {}".format(definitions))

    base = None
    base_compiler = None
    for defn in definitions:
        if not isinstance(defn, dict):
            continue

        if 'base' in defn:
            base = defn['base']

        if 'base-compiler' in defn:
            base_compiler = defn['base-compiler']
            if not isinstance(base_compiler, list) or  len(base_compiler) != 1:
                error("Expected base_compiler definition to be a list of one item, got '{}'"
                      .format(base_compiler))

            base_compiler = base_compiler[0]

    if not base:
        error("Could not find 'base' definitions in the spack.yaml.")

    if not base_compiler:
        error("Could not find 'base-compiler' definition in the spack.yaml.")

    missing = []
    mismatched = []
    for package in base:
        pkg_def = PACKAGE_RE.match(package)
        if not pkg_def:
            warn("Could not parse package def: '{}'".format(package))

        pkg_def = pkg_def.groupdict()

        matches = find_spec(specs, pkg=pkg_def['pkg'])
        if not matches:
            missing.append(package)

        for spec in matches:
            if spec.compiler != base_compiler:
                mismatched.append((package, spec))
        
    if missing:
        print("These packages were in base, but we couldn't find a concretized spec:")

        for package in missing:
            print("  -", package)

    if mismatched:
        print("These packages were built with the wrong compiler.")
        print("Expected {}".format(base_compiler))
        for package, spec in mismatched:
            print(" ", spec.pkg, spec.version, spec.compiler)

    if not missing or mismatched:
        print("No mismatched or missing base packages.")
        return 0
    else:
        return 1


def check_packages(specs, spack_yaml):
    """Make sure all of the concretized specs match the versions specified in the packages 
    section."""

    packages = spack_yaml.get('spack', {}).get('packages', {})

    if not packages:
        error("Packages section in spack.yaml was empty.")

    missing_package_defs = set()
    no_version = set()
    wrong_version = set()
    for spec in specs:
        if spec.pkg not in packages:
            missing_package_defs.add(spec)
        pkg_defaults = packages[spec.pkg]
        def_version = pkg_defaults.get('version', [])

        if not def_version:
            no_version.add(spec)

        if spec.version not in def_version:
            wrong_version.add(spec)
        

    if not (missing_package_defs or no_version or wrong_version):
        print("All concretized versions match the defined default versions.")
        return 0

    if missing_package_defs:
        print("The following packages were concretized, \n"
              "but had no defined defaults:")
        for spec in missing_package_defs:
            print(" ", spec.pkg)

    if no_version:
        print("These packages had package defaults, but no set version:")
        for spec in no_version:
            print(" ", spec.pkg)

    if wrong_version:
        print("These packages were concretized at a version outside of the set defaults:")
        for spec in wrong_version:
            pkg_defaults = packages[spec.pkg]
            def_version = pkg_defaults.get('version', [])
            print("  {:15s} @{:15s} - expected {}"
                  .format(spec.pkg, spec.version, def_version))

    return 1


def find_spec(specs, pkg=None, version=None, compiler=None, shash=None):
    """Find only specs that match all of the given criteria."""

    found = []
    for spec in specs:
        if pkg and spec.pkg != pkg:
            continue
        elif version and spec.version != version:
            continue
        elif compiler and spec.compiler != compiler:
            continue
        elif shash and spec.shash != shash:
            continue

        found.append(spec)

    return found



    



if __name__ == '__main__':
    main()
